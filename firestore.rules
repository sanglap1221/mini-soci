rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================
    // USERS
    // ======================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ======================
    // CHATS
    // ======================
    match /chats/{chatId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isParticipant() {
        return isSignedIn() &&
          request.resource.data.participants is list &&
          request.resource.data.participants.hasAny([request.auth.uid]);
      }

      function isExistingParticipant() {
        return isSignedIn() &&
          resource.data.participants is list &&
          resource.data.participants.hasAny([request.auth.uid]);
      }

      allow read: if isSignedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        resource.data.participants.hasAny([request.auth.uid])
      );

      allow create: if isParticipant();
      allow update: if isExistingParticipant();
      allow delete: if isExistingParticipant();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ======================
    // NOTIFICATIONS
    // ======================
    match /notifications/{notificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isRecipient() {
        return isSignedIn() && request.auth.uid == resource.data.toUserId;
      }

      function isCreator() {
        return isSignedIn() && request.auth.uid == resource.data.fromUserId;
      }

      allow get, list: if isRecipient() || isCreator();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'type', 'createdAt',
          'isRead', 'readAt', 'payload', 'fromUserName',
          'fromUserAvatar', 'message', 'status'
        ]) &&
        request.resource.data.keys().hasAll([
          'fromUserId', 'toUserId', 'type', 'createdAt', 'isRead'
        ]) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.type in [
          'friend_request', 'friend_request_accepted', 'friend_request_declined',
          'message', 'post_like', 'post_comment'
        ] &&
        (request.resource.data.createdAt is timestamp ||
          request.resource.data.createdAt == request.time) &&
        request.resource.data.isRead == false &&
        (!request.resource.data.keys().hasAny(['readAt']) ||
          request.resource.data.readAt == null) &&
        (!request.resource.data.keys().hasAny(['payload']) ||
          request.resource.data.payload is map) &&
        (!request.resource.data.keys().hasAny(['fromUserName']) ||
          request.resource.data.fromUserName is string) &&
        (!request.resource.data.keys().hasAny(['fromUserAvatar']) ||
          request.resource.data.fromUserAvatar is string) &&
        (!request.resource.data.keys().hasAny(['message']) ||
          request.resource.data.message is string) &&
        (!request.resource.data.keys().hasAny(['status']) ||
          request.resource.data.status is string);

      allow update: if isRecipient() &&
        request.resource.data.isRead == true &&
        (request.resource.data.readAt is timestamp ||
          request.resource.data.readAt == request.time);

      allow delete: if isRecipient();
    }

    // ======================
    // CALLS (WebRTC Audio/Video)
    // ======================
    match /calls/{callId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isCallParticipant() {
        return isSignedIn() && (
          (resource.data.keys().hasAny(['callerId']) &&
           resource.data.callerId == request.auth.uid) ||
          (resource.data.keys().hasAny(['calleeId']) &&
           resource.data.calleeId == request.auth.uid) ||
          (resource.data.keys().hasAny(['participants']) &&
           resource.data.participants is list &&
           resource.data.participants.hasAny([request.auth.uid]))
        );
      }

      function isCallCreator() {
        return isSignedIn() &&
          request.resource.data.callerId == request.auth.uid;
      }

      // ✅ FIXED: allow read for any participant (including ended calls)
      allow read: if isCallParticipant();

      allow create: if isCallCreator() &&
        request.resource.data.keys().hasAll([
          'callId',
          'callerId',
          'calleeId',
          'status',
          'timestamp',
          'isVideoCall',
          'participants',
          'offer',
          'answer',
          'callerCandidates',
          'calleeCandidates'
        ]) &&
        request.resource.data.callerId == request.auth.uid &&
        request.resource.data.calleeId is string &&
        request.resource.data.calleeId != request.auth.uid &&
        request.resource.data.status in ['ringing', 'active', 'ended', 'rejected', 'cancelled'] &&
        request.resource.data.isVideoCall is bool &&
        request.resource.data.participants == [
          request.resource.data.callerId,
          request.resource.data.calleeId
        ];

      allow update: if isCallParticipant();

      // 🔹 Only allow delete when the call status is terminal to prevent accidental removal of active calls.
      allow delete: if isCallParticipant() &&
        (resource.data.status in ['ended', 'rejected', 'cancelled']);
    }
  }
}
